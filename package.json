{
    "name":  "dsh-tools",
    "version": "0.6.5",
    "private":  true,
    "description":  "Desktop utilities for DeepSeek Harness: a More menu in the Windows caption bar with one-click app restart.",
    "license":  "MIT",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           }
            }
}